# Gmail address that owns the App Password (SMTP login)
GMAIL_USER=taiwomubarak63@gmail.com

# 16-character Gmail App Password (NOT your normal password)
# Guide: see README.md → "Gmail App Password setup"
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Where contact form messages are delivered
CONTACT_TO=taiwomubarak63@gmail.com

# Local Express API port (Vite proxies /api → this)
PORT=3001

# Comma-separated allowed browser origins for CORS (required in production)
# Example Netlify: https://yoursite.netlify.app,https://thismubi.com
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080,https://thismubi.netlify.app
